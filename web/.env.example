# Server-only. Never prefix these with NEXT_PUBLIC_.
ROOSTER_API_URL=http://localhost:8000
ROOSTER_API_KEY=change-me

# Auth.js (Google sign-in). Generate AUTH_SECRET with `npx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET=
# Public origin of this app. The Google redirect URI to register is <AUTH_URL>/api/auth/callback/google.
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Invite-only: comma-separated Google emails, case-insensitive. Empty = nobody can sign in.
ROOSTER_ALLOWED_EMAILS=
