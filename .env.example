# Copy to .env (gitignored). docker compose reads it; the host-side tools below can too
# (`set -a && source .env && set +a`).

# Postgres (the compose `db` service is created with these)
POSTGRES_USER=rooster
POSTGRES_PASSWORD=rooster
POSTGRES_DB=rooster

# Host-side tools (SQL migrations, loaders, dbt, uvicorn without Docker) reach the db here.
# Inside compose the API gets its own DATABASE_URL pointing at the `db` service.
DATABASE_URL=postgresql://rooster:rooster@localhost:5432/rooster

# API
OPENAI_API_KEY=
# Shared secret between web and API (X-Rooster-Key). Any long random string.
ROOSTER_API_KEY=change-me
# API -> sandbox. Compose sets http://sandbox:8080; without Docker, run the sandbox on 8001.
ROOSTER_SANDBOX_URL=http://localhost:8001

# Web (server-only; never NEXT_PUBLIC_). Without Docker put these in web/.env.local.
ROOSTER_API_URL=http://localhost:8000
# Web sign-in (Auth.js + Google; see README "Google sign-in"). Without Docker put these in web/.env.local too.
# AUTH_SECRET: `openssl rand -base64 33`. AUTH_URL: public origin of the web app; Google redirect
# URI to register is <AUTH_URL>/api/auth/callback/google.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Invite-only: comma-separated Google emails allowed to sign in (case-insensitive). Empty = nobody.
# Compose requires AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET and this to be non-empty.
ROOSTER_ALLOWED_EMAILS=
